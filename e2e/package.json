{
  "name": "ecommerce-e2e",
  "private": true,
  "description": "End-to-end tests of the shop in a real browser, on the whole stack (nginx, BFF, Keycloak, API, storage)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  }
}
