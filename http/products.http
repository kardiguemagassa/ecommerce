# Tokens: see http-client.env.json (first use: ./scripts/dev-token.sh alice@example.com).
@baseUrl = http://localhost:8080

### Sign in as the shop administrator (token valid 5 minutes: run again when a request answers 401)
POST {{keycloakUrl}}/realms/ecommerce/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=ecommerce-dev-cli&username={{adminEmail}}&password={{demoPassword}}&scope=openid

> {% client.global.set("adminToken", response.body.access_token); %}

### Create a category for the products → 201
POST {{baseUrl}}/api/categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"name": "Electronics"}

> {% client.global.set("categoryId", response.body.id); %}

### Create a product → 201
POST {{baseUrl}}/api/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"name": "Laptop", "description": "15 inch", "price": 999.99, "stock": 10, "categoryId": {{categoryId}}}

> {% client.global.set("productId", response.body.id); %}

### Invalid product → 400
POST {{baseUrl}}/api/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"name": "", "price": 0, "stock": -1}

### List products (default: page 0, size 20, sorted by name) → 200
GET {{baseUrl}}/api/products

### Filter by category → 200
GET {{baseUrl}}/api/products?categoryId={{categoryId}}

### Search by name, sorted by price → 200
GET {{baseUrl}}/api/products?name=lap&sort=price,desc

### Sort by a forbidden property → 400
GET {{baseUrl}}/api/products?sort=password

### Get the product → 200
GET {{baseUrl}}/api/products/{{productId}}

### Update the product → 200
PUT {{baseUrl}}/api/products/{{productId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"name": "Laptop Pro", "description": "16 inch", "price": 1499.00, "stock": 5, "categoryId": {{categoryId}}}

### Upload the product image (JPEG, PNG or WebP, 2 MB at most; stored as JPEG 4:3) → 200, with imageUrl
PUT {{baseUrl}}/api/products/{{productId}}/image
Authorization: Bearer {{adminToken}}
Content-Type: multipart/form-data; boundary=upload

--upload
Content-Disposition: form-data; name="file"; filename="sample.png"
Content-Type: image/png

< ./images/sample.png
--upload--

> {% client.global.set("imageUrl", response.body.imageUrl); %}

### Read the image from the media storage, anonymously (as a browser) → 200 image/jpeg
GET {{imageUrl}}

### A file that is not an image, whatever its name → 415 UNSUPPORTED_IMAGE
PUT {{baseUrl}}/api/products/{{productId}}/image
Authorization: Bearer {{adminToken}}
Content-Type: multipart/form-data; boundary=upload

--upload
Content-Disposition: form-data; name="file"; filename="fake.png"
Content-Type: image/png

<svg xmlns="http://www.w3.org/2000/svg" onload="alert(1)"/>
--upload--

### Remove the product image → 204
DELETE {{baseUrl}}/api/products/{{productId}}/image
Authorization: Bearer {{adminToken}}

### Delete the category while it has products → 409
DELETE {{baseUrl}}/api/categories/{{categoryId}}
Authorization: Bearer {{adminToken}}

### Delete the product → 204
DELETE {{baseUrl}}/api/products/{{productId}}
Authorization: Bearer {{adminToken}}

### Delete the now empty category → 204
DELETE {{baseUrl}}/api/categories/{{categoryId}}
Authorization: Bearer {{adminToken}}
