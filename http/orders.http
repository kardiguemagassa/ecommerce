# Tokens: see http-client.env.json (first use: ./scripts/dev-token.sh alice@example.com).
@baseUrl = http://localhost:8080

### Sign in as the shop administrator (token valid 5 minutes: run again when a request answers 401)
POST {{keycloakUrl}}/realms/ecommerce/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=ecommerce-dev-cli&username={{adminEmail}}&password={{demoPassword}}&scope=openid

> {% client.global.set("adminToken", response.body.access_token); %}

### Sign in as the customer alice@example.com
POST {{keycloakUrl}}/realms/ecommerce/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=ecommerce-dev-cli&username={{customerEmail}}&password={{demoPassword}}&scope=openid

> {% client.global.set("customerToken", response.body.access_token); %}

### Create a category → 201
POST {{baseUrl}}/api/categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"name": "Orders demo {{$timestamp}}"}

> {% client.global.set("categoryId", response.body.id); %}

### Create a product with a stock of 3 → 201
POST {{baseUrl}}/api/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"name": "Keyboard", "price": 49.90, "stock": 3, "categoryId": {{categoryId}}}

> {% client.global.set("productId", response.body.id); %}

### Add 2 keyboards to the cart → 200
POST {{baseUrl}}/api/me/cart/items
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{"productId": {{productId}}, "quantity": 2}

### Place the order → 201, status PENDING (immediate response)
POST {{baseUrl}}/api/me/orders
Authorization: Bearer {{customerToken}}

> {% client.global.set("orderId", response.body.id); %}

### Get the order right away → PENDING
GET {{baseUrl}}/api/me/orders/{{orderId}}
Authorization: Bearer {{customerToken}}

### Get the order again after 3 seconds → CONFIRMED
GET {{baseUrl}}/api/me/orders/{{orderId}}
Authorization: Bearer {{customerToken}}

### The cart is now empty → 200
GET {{baseUrl}}/api/me/cart
Authorization: Bearer {{customerToken}}

### The stock went from 3 to 1 → 200
GET {{baseUrl}}/api/products/{{productId}}

### Order with an empty cart → 409
POST {{baseUrl}}/api/me/orders
Authorization: Bearer {{customerToken}}

### Add the last keyboard to the cart → 200
POST {{baseUrl}}/api/me/cart/items
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{"productId": {{productId}}, "quantity": 1}

### Meanwhile, the stock drops to 0 → 200
PUT {{baseUrl}}/api/products/{{productId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"name": "Keyboard", "price": 49.90, "stock": 0, "categoryId": {{categoryId}}}

### Order now fails: stock rechecked at checkout → 409
POST {{baseUrl}}/api/me/orders
Authorization: Bearer {{customerToken}}

### Rollback: the cart still contains the keyboard → 200
GET {{baseUrl}}/api/me/cart
Authorization: Bearer {{customerToken}}

### Order history, newest first → 200
GET {{baseUrl}}/api/me/orders
Authorization: Bearer {{customerToken}}

### Order that is not mine → 404
GET {{baseUrl}}/api/me/orders/999999
Authorization: Bearer {{customerToken}}

### Customer support: search the customers by name or e-mail (administrators) → 200
GET {{baseUrl}}/api/admin/customers?q=alice
Authorization: Bearer {{adminToken}}

> {% client.global.set("customerId", response.body.content[0].id); %}

### Their orders, newest first → 200
GET {{baseUrl}}/api/admin/customers/{{customerId}}/orders
Authorization: Bearer {{adminToken}}

### Customer search by a customer → 403
GET {{baseUrl}}/api/admin/customers
Authorization: Bearer {{customerToken}}
