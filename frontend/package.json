{
  "name": "ecommerce-web",
  "private": true,
  "version": "2.0.2",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "api:types": "openapi-typescript openapi.json --output src/api/schema.d.ts",
    "api:sync": "node scripts/openapi.mjs sync ../target/openapi.json && npm run api:types",
    "predev": "npm run api:types",
    "dev": "vite",
    "prebuild": "npm run api:types",
    "build": "tsc --build && vite build",
    "pretypecheck": "npm run api:types",
    "typecheck": "tsc --build",
    "prelint": "npm run api:types",
    "lint": "eslint --max-warnings 0 .",
    "pretest": "npm run api:types",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/inter": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@tanstack/react-query": "5.105.3",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
