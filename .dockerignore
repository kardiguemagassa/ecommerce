# Build context: only what the Dockerfile needs. Faster builds, and no secret ever ends up in a layer.
target/
.git/
.idea/
*.iml
.vscode/
**/*.log
.DS_Store
.env
.env.*
!.env.example
http/
observability/
# React front-end: built by its own image (nginx), not part of the API image
frontend/
# End-to-end tests: run from the host against the stack, never part of an image
e2e/
