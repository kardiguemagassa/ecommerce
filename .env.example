# Copy to .env (git-ignored) and set your own values. Read by Spring (spring.config.import) and by Docker Compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_db
POSTGRES_USERNAME=change-me
POSTGRES_PASSWORD=change-me

# Media storage (product images, avatars): SeaweedFS, S3 API on http://localhost:8333. Credentials of the API,
# also the only account of the storage. Production: the endpoint and keys of any S3 provider (MEDIA_ENDPOINT...).
MEDIA_ACCESS_KEY=change-me
MEDIA_SECRET_KEY=change-me-please

# Observability: traces, metrics and logs sent over OTLP to grafana/otel-lgtm (compose), Grafana on localhost:3000.
# Every request traced in development (10 % by default).
TRACING_SAMPLING_PROBABILITY=1.0

# Keycloak (identity provider): http://localhost:8180, realm "ecommerce"; admin console with the account below
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
# Secret of the confidential client of the API (BFF: browser login, tokens kept server-side)
BFF_CLIENT_SECRET=change-me
# Demo users of the realm: alice@example.com (CUSTOMER) and the shop administrator below (CUSTOMER and ADMIN),
# both with this password (12 characters minimum). Use your own e-mail for the administrator: it stays in .env.
DEMO_USER_PASSWORD=change-me-please
SHOP_ADMIN_EMAIL=admin@example.com

# Optional: "Sign in with Google" (./scripts/keycloak-google.sh). OAuth client "Web application" in the Google Cloud
# console, authorized redirect URI http://localhost:8180/realms/ecommerce/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
